{
  "manifest_version": 3,
  "name": "Flow",
  "version": "1.0",
  "description": "Snapshot browser tabs for Flow.",
  "permissions": ["tabs", "alarms", "identity"],
  "host_permissions": [
  "http://localhost:7382/*",
  "http://localhost:7383/*",
  "http://localhost:7384/*",
  "http://localhost:7385/*",
  "http://localhost:7386/*",
  "http://localhost:7387/*",
  "http://localhost:7388/*",
  "http://localhost:7389/*",
  "http://localhost:7390/*",
  "http://localhost:7391/*",
  "http://localhost:7392/*",
  "http://localhost:7393/*",
  "http://localhost:7394/*",
  "http://localhost:7395/*",
  "http://localhost:7396/*",
  "http://localhost:7397/*",
  "http://localhost:7398/*",
  "http://localhost:7399/*"
  ],
  "icons": {
    "16": "images/16.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "action": {
    "default_title": "Snapshot Tabs", 
    "default_icon": "images/16.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}